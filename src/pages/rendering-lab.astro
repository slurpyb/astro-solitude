---
import HydrationProbe from '../components/prototypes/rendering-lab/HydrationProbe';
import Base from '../layouts/Base.astro';

const renderMode =
  process.env.SOLITUDE_RENDER_MODE === 'server' ? 'server' : 'static';
const renderedAt = new Date().toISOString();
const requestId = crypto.randomUUID();
const requestUserAgent =
  renderMode === 'server'
    ? (Astro.request.headers.get('user-agent') ??
      'request did not include a user agent')
    : 'unavailable during static generation';
---

<Base
  title="Rendering mode lab"
  description="Throwaway comparison of Astro static and server output with React hydration directives."
  type="rendering-lab"
  page={{ toc: false, comment: false, right_menu: false }}
>
  <main class="rendering-lab">
    <header class="rendering-lab__intro">
      <p class="rendering-lab__eyebrow">Throwaway prototype</p>
      <h1>Astro rendering mode lab</h1>
      <p>
        Reload this page and compare the request metadata. Static output keeps
        the same build-time values; Node SSR creates new values for every
        request.
      </p>
      <dl class="rendering-lab__request-state">
        <div>
          <dt>Output mode</dt>
          <dd>{renderMode}</dd>
        </div>
        <div>
          <dt>Rendered at</dt>
          <dd>{renderedAt}</dd>
        </div>
        <div>
          <dt>Request ID</dt>
          <dd>{requestId}</dd>
        </div>
        <div>
          <dt>User agent</dt>
          <dd>{requestUserAgent}</dd>
        </div>
      </dl>
    </header>

    <section class="rendering-lab__grid" aria-labelledby="immediate-heading">
      <h2 id="immediate-heading" class="rendering-lab__section-heading">
        Immediate comparisons
      </h2>

      <HydrationProbe
        mode="Astro SSR only"
        description="React renders HTML on the server/build, but no JavaScript is sent. The button intentionally stays inert."
        initialServerTimestamp={renderedAt}
      />

      <HydrationProbe
        client:load
        mode="client:load"
        description="Hydrates as soon as the page JavaScript loads. Best for immediately interactive controls."
        initialServerTimestamp={renderedAt}
      />

      <HydrationProbe
        client:idle
        mode="client:idle"
        description="Waits until the browser is idle before hydrating. Useful for lower-priority interaction."
        initialServerTimestamp={renderedAt}
      />

      <HydrationProbe
        client:only="react"
        mode="client:only"
        description="Skips server HTML entirely and renders only in the browser. Watch for the initially empty card position."
        initialServerTimestamp="not rendered on the server"
      />

      <HydrationProbe
        client:media="(max-width: 50rem)"
        mode="client:media"
        description="Hydrates only when the viewport is 50rem wide or narrower. Resize to cross the condition."
        initialServerTimestamp={renderedAt}
      />
    </section>

    <div class="rendering-lab__scroll-marker" aria-hidden="true">
      Scroll to trigger the visibility island
    </div>

    <section class="rendering-lab__grid" aria-labelledby="deferred-heading">
      <h2 id="deferred-heading" class="rendering-lab__section-heading">
        Deferred by visibility
      </h2>
      <HydrationProbe
        client:visible
        mode="client:visible"
        description="Server HTML is present immediately, but interaction waits until this card enters the viewport."
        initialServerTimestamp={renderedAt}
      />
    </section>
  </main>
</Base>

<style is:global>
  .rendering-lab {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 7rem 0 5rem;
  }

  .rendering-lab__intro,
  .hydration-probe {
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, currentColor 4%, transparent);
  }

  .rendering-lab__intro {
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .rendering-lab__eyebrow {
    margin: 0 0 0.5rem;
    font:
      700 0.75rem/1.2 ui-monospace,
      monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .rendering-lab h1 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 4.5rem);
    line-height: 0.95;
  }

  .rendering-lab__request-state,
  .hydration-probe dl {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
  }

  .rendering-lab__request-state {
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .rendering-lab dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .rendering-lab dd {
    margin: 0.2rem 0 0;
    overflow-wrap: anywhere;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
  }

  .rendering-lab__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .rendering-lab__section-heading {
    grid-column: 1 / -1;
    margin: 1rem 0 0;
  }

  .hydration-probe {
    padding: 1.25rem;
  }

  .hydration-probe__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hydration-probe h2 {
    margin: 0;
    font-size: 1.05rem;
  }

  .hydration-status {
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    font:
      700 0.7rem/1 ui-monospace,
      monospace;
  }

  .hydration-status--waiting {
    background: #f5a524;
    color: #231600;
  }

  .hydration-status--hydrated {
    background: #45d483;
    color: #052313;
  }

  .hydration-probe button {
    width: 100%;
    margin-top: 1rem;
    border: 1px solid currentColor;
    border-radius: 0.65rem;
    padding: 0.7rem 1rem;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .rendering-lab__scroll-marker {
    display: grid;
    min-height: 80vh;
    place-items: center;
    margin-top: 2rem;
    border-block: 1px dashed color-mix(in srgb, currentColor 25%, transparent);
    opacity: 0.65;
  }
</style>
