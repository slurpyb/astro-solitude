{
  "name": "astro-solitude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "astro dev",
    "dev:lab:static": "SOLITUDE_RENDER_MODE=static astro dev --host 127.0.0.1 --port 4331",
    "dev:lab:server": "SOLITUDE_RENDER_MODE=server astro dev --host 127.0.0.1 --port 4332",
    "build": "astro build",
    "build:lab:static": "SOLITUDE_RENDER_MODE=static SOLITUDE_OUT_DIR=dist-static astro build",
    "build:lab:server": "SOLITUDE_RENDER_MODE=server SOLITUDE_OUT_DIR=dist-server astro build",
    "preview": "astro preview",
    "preview:lab:static": "SOLITUDE_RENDER_MODE=static SOLITUDE_OUT_DIR=dist-static astro preview --host 127.0.0.1 --port 4331",
    "start:lab:server": "SOLITUDE_RENDER_MODE=server HOST=127.0.0.1 PORT=4332 node dist-server/server/entry.mjs",
    "check": "pnpm check:scripts && pnpm check:astro",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "migrate:hugo": "tsx scripts/migrate-hugo.ts",
    "build:fixture": "tsx scripts/build-fixture.ts",
    "docs:generate": "tsx scripts/document-inventory.ts",
    "docs:check": "tsx scripts/check-docs.ts && tsx scripts/document-inventory.ts --check",
    "check:scripts": "astro sync && tsc --noEmit -p tsconfig.scripts.json",
    "check:astro": "astro check",
    "check:visual": "tsx scripts/modernization-check.ts",
    "check:size": "tsx scripts/measure-load.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@fortawesome/fontawesome-free": "7.3.0",
    "astro": "7.3.2",
    "katex": "0.18.7",
    "marked": "17.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "24.13.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "satteri": "0.10.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
